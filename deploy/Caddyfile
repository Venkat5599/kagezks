# Caddy block for kageai.me on the Kage VPS (append to /etc/caddy/Caddyfile, then `systemctl reload caddy`).
#
# Routes:
#   /fabric/mcp, /fabric/health -> agent fabric MCP (pm2: kage-fabric, :8403) — public
#   /fabric/* (other)           -> same server, only with the X-Kage-Gateway header
#                                  (provision/run spend relayer XLM; the web app sends it)
#   everything else             -> the Next.js app on Vercel (owns /mcp/<slug> descriptors)
#
# Replace <KAGE_FABRIC_GATEWAY_TOKEN> with the value in deploy/.env and in the Vercel
# project env (KAGE_FABRIC_GATEWAY_TOKEN). Vercel env: KAGE_FABRIC_URL=https://kageai.me/fabric

kageai.me, www.kageai.me {
	encode gzip

	@fabric_public path /fabric/mcp /fabric/health
	handle @fabric_public {
		uri strip_prefix /fabric
		reverse_proxy localhost:8403
	}

	@fabric_gated {
		path /fabric/*
		header X-Kage-Gateway <KAGE_FABRIC_GATEWAY_TOKEN>
	}
	handle @fabric_gated {
		uri strip_prefix /fabric
		reverse_proxy localhost:8403
	}

	handle /fabric/* {
		respond "forbidden" 403
	}

	handle {
		reverse_proxy https://kagezks.vercel.app {
			header_up Host kagezks.vercel.app
		}
	}
}
